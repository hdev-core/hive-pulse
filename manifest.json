{
  "manifest_version": 3,
  "name": "HivePulse",
  "version": "1.14.0",
  "description": "Your Hive blockchain dashboard: wallet, scam protection, chat, notifications, post SEO analysis, and instant frontend switching.",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "HivePulse",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://peakd.com/*",
        "https://ecency.com/*",
        "https://hive.blog/*",
        "https://inleo.io/*",
        "https://leofinance.io/*",
        "https://3speak.tv/*",
        "https://actifit.io/*",
        "https://slothbuzz.com/*",
        "https://www.slothbuzz.com/*",
        "https://blog.suseona.com/*"
      ],
      "js": [
        "assets/compose.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "alarms",
    "sidePanel",
    "cookies",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://ecency.com/*",
    "https://peakd.com/*",
    "https://hive.blog/*",
    "https://inleo.io/*",
    "https://leofinance.io/*",
    "https://3speak.tv/*",
    "https://actifit.io/*",
    "https://api.hive.blog/*",
    "https://images.ecency.com/*",
    "https://api.hive-engine.com/*",
    "https://api2.hive-engine.com/*",
    "https://api.coingecko.com/*",
    "https://images.hive.blog/*",
    "https://ipfs.io/*",
    "https://slothbuzz.com/*",
    "https://www.slothbuzz.com/*",
    "https://api.deathwing.me/*",
    "https://api.openhive.network/*",
    "https://hiveapi.actifit.io/*",
    "https://techcoderx.com/*",
    "https://api.syncad.com/*",
    "https://rpc.mahdiyari.info/*",
    "https://api.c0ff33a.uk/*",
    "https://hive.atexoras.com/*",
    "https://v6-he.atexoras.com/*",
    "https://herpc.actifit.io/*",
    "https://he.c0ff33a.uk/*",
    "https://herpc.dtools.dev/*",
    "https://blog.suseona.com/*"
  ]
}
